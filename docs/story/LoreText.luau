local byId: { [string]: Entry } = {}
for _, e in entries do
	byId[e.id] = e
end
local sceneById: { [string]: Scene } = {}
for _, s in scenes do
	sceneById[s.id] = s
end

local LoreText = {}
LoreText.entries = entries
LoreText.scenes = scenes
LoreText.looks = looks
LoreText.voices = voices

function LoreText.get(id: string): Entry?
	return byId[id]
end

function LoreText.scene(id: string): Scene?
	return sceneById[id]
end

function LoreText.look(key: string)
	return looks[key]
end

function LoreText.ofKind(kind: string): { Entry }
	local r = {}
	for _, e in entries do
		if e.kind == kind then
			table.insert(r, e)
		end
	end
	return r
end

return LoreText
