local byId: { [string]: Entry } = {}
for _, e in entries do
	byId[e.id] = e
end

local LoreText = {}
LoreText.entries = entries

function LoreText.get(id: string): Entry?
	return byId[id]
end

function LoreText.ofKind(kind: string): { Entry }
	local r = {}
	for _, e in entries do
		if e.kind == kind then
			table.insert(r, e)
		end
	end
	return r
end

return LoreText
