--!strict
-- Authored difficulty tiers. Adding a tier is a data change: append a row.
-- Names are the story's floors (docs/story/01-story-bible.md): two tiers to a floor.
-- Past the last authored tier, Difficulty.forTier() derives endless tiers from the final row.

export type Tier = {
	name: string,
	width: number,
	height: number,
	loopChance: number, -- extra passages; higher is more forgiving
	pruneChance: number, -- share of dead ends opened up
	rooms: number, -- open multi-cell rooms carved into the maze
	enemies: { [string]: number },
	enemySpeedScale: number,
	enemySenseScale: number, -- multiplies how far enemies hear and see; below 1 is forgiving
	objectives: { min: number, max: number },
	exitLocked: boolean, -- true: the key is required to open the exit
	flooded: number, -- share of cells that are flooded (loud to move through)
	lamps: number, -- lamp-bags: small pools of real light, one every minute or so of the level
	echoes: number, -- hidden objects that reveal themselves, and a line of story, when scanned
	pits: number, -- holes in the floor
	plates: number, -- alarm plates that make a loud noise when stepped on
	sweepScale: number, -- above 1 the Trickle Charger wins charges back more slowly: resources tighten
	batteries: number, -- battery cells hidden in the level; each gives 1 or 2 sweep charges
	reward: number, -- Static paid on clear
	gate: string?, -- the item that opens a locked exit, named by its story entry ("fuse" is item.fuse)
	loreRoomAfter: string?, -- id of the lit safe room that follows this tier: a haven or a big lit room
}

