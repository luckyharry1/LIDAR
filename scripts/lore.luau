--!strict
-- Prints docs/LORE.md: a short guide to the story and how the game delivers it, followed by
-- everything the player reads, floor by floor, exactly as src/shared/data/Lore.luau assembles
-- it from the story thread's text.
-- Usage: lune run scripts/lore > docs/LORE.md
local Lore = require("../src/shared/data/Lore")
local Tiers = require("../src/shared/data/Tiers")

local out: { string } = {}
local function line(text: string?)
	table.insert(out, text or "")
end

-- Text as a Markdown block quote that keeps its line breaks.
local function quote(text: string)
	local pieces = string.split(text, "\n")
	for index, piece in pieces do
		local hardBreak = index < #pieces and piece ~= "" and pieces[index + 1] ~= ""
		line(if piece == "" then ">" else "> " .. piece .. (if hardBreak then "\\" else ""))
	end
end

line("# Lore")
line()
line("<!-- Generated by `lune run scripts/lore > docs/LORE.md`. Do not edit by hand: change the")
line("     words in docs/story (build_text.py regenerates LoreText.luau) or where they go in")
line("     src/shared/data/Lore.luau, then run the script again. -->")
line()
line("A short guide to the story and how the game delivers it. The story itself, what is")
line("really going on, the cast and the tone are in `docs/story/01-story-bible.md`; every line")
line("with its id is in `docs/story/03-ingame-text.md`.")
line()
line("## The story, briefly")
line()
line("Under the Halden Building there is a stair that is not on the plans, and below it the")
line("Understory: the place a building forgets. Six survey crews went down to map it. The")
line('player is Crew 7, called only "Seven", carrying the rig Ines Calder built: it does not')
line("make light, it makes a record. Nobody explains what the dark is, why the monsters were")
line('once people, why the sign-in sheet says Crew 7 came in "again", or why every time the')
line("dark takes you, you wake at the last lit room. The player puts it together.")
line()
line("## How the game tells it")
line()
line("The game never lectures. Everything comes from things that exist in the world, written")
line("by people who assumed the reader already knew:")
line()
line("| Where | What the player meets |")
line("| --- | --- |")
line(
	"| Lit rooms | Three notes each: sign-in sheets, tapes, a corkboard, a guest book. Read at a prompt. |"
)
line(
	"| Hidden recorders | Scan one enough and it reveals itself and plays the next tape, in story order. |"
)
line(
	"| Manual pages | The rare gold page in a maze: one numbered rule from the survey manual, with the crew's margin notes. |"
)
line(
	"| The radio | Base reports and counts. Near a disguised Echo a false Base gives directions; real Base never does. |"
)
line("| Hints | Staff notices and manual rules, with the control for your device in brackets. |")
line("| The field guide | The manual's page for each monster you have met, then its plain rule. |")
line("| The finale | Ines, in the Lamp Room, and a choice. |")
line()

-- Tapes are heard in order, one per recorder revealed, whatever level it is on. This is the
-- order for a player who finds every recorder on the authored floors.
local tapeAt: { [number]: { number } } = {}
local nextTape = 1
for tier, def in Tiers do
	tapeAt[tier] = {}
	for _ = 1, def.echoes do
		table.insert(tapeAt[tier], nextTape)
		nextTape += 1
	end
end

local roomAfter: { [number]: string } = {}
for tier, def in Tiers do
	if def.loreRoomAfter then
		roomAfter[tier] = def.loreRoomAfter
	end
end

local function room(id: string)
	local data = Lore.rooms[id]
	line(`#### Lit room: {data.title}`)
	line()
	line(`*{data.subtitle}*`)
	line()
	for _, noteId in data.notes do
		local note = Lore.notes[noteId]
		line(`**{note.title}**`)
		line()
		quote(note.body)
		line()
	end
end

line("## Floor by floor")
line()
line("Tapes are numbered in the order a player hears them if they find every recorder.")
line()
for _, section in Lore.sections do
	line(`### {section.floor}: {section.card.title}`)
	line()
	line(`*{section.card.subtitle}*, tiers {section.first} and {section.last}.`)
	line()
	for tier = section.first, section.last do
		for _, index in tapeAt[tier] or {} do
			local tape = Lore.echoes[index]
			line(`**Tape {index}** (tier {tier}), {tape.speaker}:`)
			line()
			quote(tape.line)
			line()
		end
	end
	local after = roomAfter[section.last]
	if after then
		room(after)
	end
end

line("### The Relay")
line()
line(
	`Endless floors past tier {#Tiers} are Relay floors; every few of them there is a lit landing.`
)
line(`The daily run is *{Lore.dailyCard.title}*, *{Lore.dailyCard.subtitle}*.`)
line()
room("landing")

line("## Manual pages")
line()
line(
	`Found in the maze, one per run at most, titled "{Lore.plateTitle}". Page 12 is in the Lamp Room.`
)
line()
for _, page in Lore.plates do
	quote(page)
	line()
end

line("## The radio")
line()
line(`**{Lore.radio.speaker}**, on a new floor: "{Lore.radio.floor}"`)
line()
line(`On the first visit to the Night Desk: "{Lore.radio.desk}"`)
line()
line(`After a level is cleared: "{Lore.radio.cleared}"`)
line()
line("Now and then in the dark:")
line()
for _, text in Lore.radio.dark do
	line(`- "{text}"`)
end
line()
line("When the dark gives you back:")
line()
for _, text in Lore.radio.back do
	line(`- "{text}"`)
end
line()
line(`**{Lore.radio.fakeSpeaker}**, only close to an Echo that is still pretending:`)
line()
for _, text in Lore.radio.fake do
	line(`- "{text}"`)
end
line()

line("## The monsters")
line()
for _, kind in { "wanderer", "listener", "mimic", "stalker" } do
	local entity = Lore.entities[kind]
	line(`**{entity.name}** ({kind})`)
	line()
	quote(entity.page)
	line()
end

line("## The finale")
line()
line("Reading the last page in the Lamp Room brings Ines. She counts the times the dark took")
line("you (the line changes if it never did), then asks.")
line()
line(`**{Lore.ending.title}**, for a player who was taken three times:`)
line()
quote(Lore.endingBody(3))
line()
line(`**{Lore.ending.choices.up}** ends that player's run and returns them to the title,`)
line("checkpoint kept:")
line()
quote(Lore.ending.cards.up.body)
line()
line(`**{Lore.ending.choices.stay}** carries on through the Lamp Room's door into the Relay:`)
line()
quote(Lore.ending.cards.stay.body)

print(table.concat(out, "\n"))
